<!--
- Template for ownership property Setup
-
- Features:
-   - Optional ownership enable
-   - Setting of primary owner
-
- Parameters:
-    {it}       - Property instance
-    item       - Described Item
-    blockName  - name of the block
-
- @remarks Use <function> to parse parameters
- @author Oleg Nenashev
- @since 0.0.3
-
-->
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
         xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:o="/lib/ownership">

    <j:set var="_item" value="${it.getDescribedItem()}"/>
    <j:set var="_userList" value="${it.helper().getPossibleOwners(it.getDescribedItem())}"/>

    <f:entry title="${%Primary Owner}" help="/plugin/ownership/help/primaryOwner.html">
        <div class="jenkins-select">
            <select name="${blockName}.primaryOwner" class="jenkins-select__input">
                <j:forEach var="user" items="${_userList}">
                    <f:option value="${user.getId()}" selected="${ it.helper().getOwnershipDescription(_item).isPrimaryOwner(user) == true }">
                        ${it.helper().getDisplayName(user)}
                    </f:option>
                </j:forEach>
            </select>
        </div>
    </f:entry>
    <f:entry title="${%Secondary owners}" help="/plugin/ownership/help/coOwner.html"/>
    <j:set var="coOwnerDatalistId" value="ownership-coowners-${h.generateId()}"/>
    <datalist id="${coOwnerDatalistId}">
        <j:forEach var="user" items="${_userList}">
            <option value="${user.getId()}">${it.helper().getDisplayName(user)}</option>
        </j:forEach>
    </datalist>
    <f:entry>
        <f:repeatable name="coOwners" add="${%Add secondary owner}" var="_coownerId" items="${it.helper().getOwnershipDescription(_item).getCoownersIds()}">
            <o:blockWrapper>
                <f:entry title="${%Secondary owner}">
                    <!-- Combobox: pick from known users or type any ID (including unregistered). -->
                    <f:textbox name="coOwner" value="${_coownerId}" list="${coOwnerDatalistId}"
                               placeholder="${%coOwner.placeholder}"
                               checkUrl="'${rootURL}/plugin/ownership/checkUser?userId='+encodeURIComponent(this.value)"
                    />
                    <f:description>
                        ${%coOwner.description}
                    </f:description>
                </f:entry>
                <f:entry title="">
                    <div class="jenkins-buttons-row jenkins-buttons-row--invert">
                        <f:repeatableDeleteButton value="Remove..."/>
                    </div>
                </f:entry>
            </o:blockWrapper>
        </f:repeatable>
    </f:entry>
</j:jelly>
