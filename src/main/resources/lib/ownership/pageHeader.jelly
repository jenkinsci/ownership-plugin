<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout">
  <st:documentation>
    Standard ownership page header using Design Library app-bar.
    <st:attribute name="title" use="required">Page title</st:attribute>
    <st:attribute name="icon">Optional symbol icon src (e.g. symbol-user)</st:attribute>
    <st:attribute name="description">Optional leading paragraph below the title</st:attribute>
  </st:documentation>
  <l:app-bar title="${title}">
    <j:if test="${attrs.icon != null}">
      <l:icon src="${icon}" class="icon-md"/>
    </j:if>
  </l:app-bar>
  <j:if test="${attrs.description != null}">
    <p class="jenkins-leading-paragraph">${description}</p>
  </j:if>
</j:jelly>
